{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  "include": ["packages/*/src", "packages/*/test", "packages/*/scripts", "plugins/_lib", "plugins/*/src", "plugins/*/test", "scripts", "apps/client/scripts", "apps/client/test"]
}
