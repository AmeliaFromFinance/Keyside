{
  "id": "dev.keyside.discord",
  "name": "Discord",
  "version": "1.2.0",
  "author": "Keyside",
  "prefix": "discord",
  "description": "Mute, deafen, voice mode and voice channel controls for the Discord desktop app, with the current state on the keys. Also works with Equibop on Linux.",
  "homepage": "https://discord.com/developers/applications",
  "license": "GPL-3.0-or-later",
  "host": "^1.0",
  "entry": "main.js",
  "icon": "headset",
  "permissions": {
    "net": ["discord.com"],
    "ipc": ["discord"],
    "run": [
      ["equibop", "--toggle-mic"],
      ["equibop", "--toggle-deafen"],
      ["equibop", "--toggle-vad"],
      ["flatpak", "run", "io.github.equicord.equibop", "--toggle-mic"],
      ["flatpak", "run", "io.github.equicord.equibop", "--toggle-deafen"],
      ["flatpak", "run", "io.github.equicord.equibop", "--toggle-vad"]
    ]
  },
  "connection": {
    "type": "object",
    "properties": {
      "app": {
        "type": "string",
        "title": "App",
        "enum": ["discord", "equibop"],
        "enumNames": ["Discord", "Equibop (Linux)"],
        "default": "discord",
        "description": "Equibop needs no application. Keys run Equibop's --toggle-mic, --toggle-deafen and --toggle-vad, so they show what Keyside last sent."
      },
      "install": {
        "type": "string",
        "title": "Equibop install",
        "enum": ["auto", "native", "flatpak"],
        "enumNames": ["Find it", "Installed package", "Flatpak"],
        "default": "auto"
      },
      "clientId": {
        "type": "string",
        "title": "Application ID (Discord only)",
        "maxLength": 32,
        "description": "Create an application at discord.com/developers, add http://127.0.0.1 under OAuth2 > Redirects and paste its Application ID and Client Secret here. Discord then asks you to allow Keyside once."
      },
      "clientSecret": { "type": "string", "format": "secret", "title": "Client secret (Discord only)" },
      "session": { "type": "string", "format": "secret", "x-hidden": true }
    }
  },
  "actions": [
    {
      "id": "mute",
      "name": "Mute",
      "icon": "mic",
      "kind": "toggle",
      "settings": { "type": "object", "properties": { "mode": { "type": "string", "title": "On press", "enum": ["toggle", "on", "off", "hold"], "enumNames": ["Toggle", "Mute", "Unmute", "Talk while held"], "default": "toggle" } } }
    },
    {
      "id": "deafen",
      "name": "Deafen",
      "icon": "headphones",
      "kind": "toggle",
      "settings": { "type": "object", "properties": { "mode": { "type": "string", "title": "On press", "enum": ["toggle", "on", "off"], "enumNames": ["Toggle", "Deafen", "Undeafen"], "default": "toggle" } } }
    },
    {
      "id": "voice-mode",
      "name": "Push to talk",
      "icon": "radio",
      "kind": "toggle",
      "settings": { "type": "object", "properties": { "mode": { "type": "string", "title": "On press", "enum": ["toggle", "on", "off"], "enumNames": ["Toggle", "Push to talk", "Voice activity"], "default": "toggle" } } }
    },
    {
      "id": "processing",
      "name": "Voice processing",
      "icon": "audio-lines",
      "kind": "toggle",
      "settings": {
        "type": "object",
        "properties": {
          "which": { "type": "string", "title": "Setting", "enum": ["noise", "echo", "agc"], "enumNames": ["Noise suppression", "Echo cancellation", "Automatic gain control"], "default": "noise" },
          "mode": { "type": "string", "title": "On press", "enum": ["toggle", "on", "off"], "enumNames": ["Toggle", "Turn on", "Turn off"], "default": "toggle" }
        }
      }
    },
    {
      "id": "join",
      "name": "Join voice channel",
      "icon": "volume-2",
      "settings": { "type": "object", "properties": { "channel": { "type": "string", "title": "Channel ID", "description": "Right-click the channel > Copy Channel ID (turn on Developer Mode first).", "maxLength": 24 } }, "required": ["channel"] }
    },
    { "id": "leave", "name": "Leave voice", "icon": "log-out" },
    { "id": "input-volume", "name": "Mic volume", "icon": "mic", "kind": "slider" },
    { "id": "output-volume", "name": "Speaker volume", "icon": "volume-2", "kind": "slider" }
  ],
  "variables": [
    { "name": "muted", "title": "Muted", "type": "boolean" },
    { "name": "deafened", "title": "Deafened", "type": "boolean" },
    { "name": "channel", "title": "Voice channel", "type": "string" }
  ]
}
