{
  "id": "dev.keyside.streamerbot",
  "name": "Streamer.bot",
  "version": "1.3.0",
  "author": "Keyside",
  "prefix": "sb",
  "description": "Run Streamer.bot actions, show its global variables and mirror chat and alerts from the platforms it is connected to.",
  "homepage": "https://streamer.bot",
  "license": "GPL-3.0-or-later",
  "host": "^1.1",
  "entry": "main.js",
  "icon": "bot",
  "permissions": { "net": ["{host}:{port}"] },
  "connection": {
    "type": "object",
    "properties": {
      "host": { "type": "string", "title": "Address", "default": "127.0.0.1" },
      "port": { "type": "integer", "title": "Port", "default": 8080, "minimum": 1, "maximum": 65535, "description": "Streamer.bot: Servers/Clients > WebSocket Server." },
      "endpoint": { "type": "string", "title": "Endpoint", "default": "/", "maxLength": 100 },
      "password": { "type": "string", "format": "secret", "title": "Password", "description": "Only if authentication is turned on in Streamer.bot." },
      "chat": { "type": "boolean", "title": "Mirror chat and alerts", "default": true }
    },
    "required": ["host", "port"]
  },
  "actions": [
    {
      "id": "run",
      "name": "Run action",
      "icon": "zap",
      "settings": {
        "type": "object",
        "properties": {
          "actionName": { "type": "string", "title": "Action", "x-options": "dynamic" },
          "args": {
            "type": "object",
            "title": "Arguments",
            "description": "Available in Streamer.bot as %name%. Values can use Keyside variables, like {obs.scene}.",
            "additionalProperties": { "type": "string" },
            "x-template": true
          }
        },
        "required": ["actionName"]
      }
    },
    {
      "id": "trigger",
      "name": "Custom trigger",
      "icon": "webhook",
      "description": "Fires a custom code trigger, so several actions can listen to one key.",
      "settings": {
        "type": "object",
        "properties": {
          "triggerName": { "type": "string", "title": "Trigger name", "maxLength": 100 },
          "args": { "type": "object", "title": "Arguments", "description": "Values can use Keyside variables.", "additionalProperties": { "type": "string" }, "x-template": true }
        },
        "required": ["triggerName"]
      }
    },
    {
      "id": "set-global",
      "name": "Set global variable",
      "icon": "variable",
      "description": "Needs a small helper action in Streamer.bot. See the plugin setup guide.",
      "settings": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "title": "Global variable", "x-options": "dynamic", "maxLength": 100 },
          "op": { "type": "string", "title": "Change", "enum": ["set", "add", "toggle"], "enumNames": ["Set to", "Add", "Toggle true/false"], "default": "set" },
          "value": {
            "type": "string",
            "title": "Value",
            "maxLength": 1000,
            "x-template": true,
            "x-showWhen": { "op": ["set", "add"] },
            "description": "Can use Keyside variables, like {twitch.viewers}."
          },
          "persisted": { "type": "boolean", "title": "Keep after Streamer.bot restarts", "default": true },
          "helper": { "type": "string", "title": "Helper action", "maxLength": 100, "default": "Keyside: Set global" }
        },
        "required": ["name"]
      }
    }
  ],
  "variables": [{ "name": "connected", "title": "Connected", "type": "boolean" }],
  "feeds": [
    { "name": "chat", "title": "Chat" },
    { "name": "events", "title": "Alerts" }
  ]
}
