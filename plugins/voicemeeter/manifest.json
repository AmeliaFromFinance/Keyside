{
  "id": "dev.keyside.voicemeeter",
  "name": "Voicemeeter",
  "version": "1.1.0",
  "author": "Keyside",
  "prefix": "vm",
  "description": "Mute, gain, routing and scripts for Voicemeeter, sent as VBAN text commands. Works over the network too.",
  "homepage": "https://vb-audio.com/Voicemeeter/vban.htm",
  "license": "GPL-3.0-or-later",
  "host": "^1.0",
  "entry": "main.js",
  "icon": "sliders-vertical",
  "permissions": { "net": ["{host}:{port}"], "udp": true },
  "connection": {
    "type": "object",
    "properties": {
      "host": { "type": "string", "title": "Address", "default": "127.0.0.1" },
      "port": { "type": "integer", "title": "VBAN port", "default": 6980, "minimum": 1, "maximum": 65535 },
      "stream": {
        "type": "string",
        "title": "Text stream name",
        "default": "Command1",
        "maxLength": 16,
        "description": "Voicemeeter: Menu > VBAN. Turn on the incoming text stream with this name and this PC's address."
      }
    },
    "required": ["host", "port"]
  },
  "actions": [
    {
      "id": "mute",
      "name": "Mute",
      "icon": "mic",
      "kind": "toggle",
      "settings": {
        "type": "object",
        "properties": {
          "target": { "type": "string", "title": "Channel", "enum": ["Strip", "Bus"], "enumNames": ["Input strip", "Output bus"], "default": "Strip" },
          "index": { "type": "integer", "title": "Number", "minimum": 1, "maximum": 8, "default": 1 },
          "mode": { "type": "string", "title": "On press", "enum": ["toggle", "on", "off"], "enumNames": ["Toggle", "Mute", "Unmute"], "default": "toggle" }
        }
      }
    },
    {
      "id": "gain",
      "name": "Gain",
      "icon": "sliders-vertical",
      "kind": "slider",
      "settings": {
        "type": "object",
        "properties": {
          "target": { "type": "string", "title": "Channel", "enum": ["Strip", "Bus"], "enumNames": ["Input strip", "Output bus"], "default": "Strip" },
          "index": { "type": "integer", "title": "Number", "minimum": 1, "maximum": 8, "default": 1 }
        }
      }
    },
    {
      "id": "route",
      "name": "Route to output",
      "icon": "cable",
      "kind": "toggle",
      "settings": {
        "type": "object",
        "properties": {
          "index": { "type": "integer", "title": "Input strip", "minimum": 1, "maximum": 8, "default": 1 },
          "output": { "type": "string", "title": "Output", "enum": ["A1", "A2", "A3", "A4", "A5", "B1", "B2", "B3"], "default": "A1" },
          "mode": { "type": "string", "title": "On press", "enum": ["toggle", "on", "off"], "enumNames": ["Toggle", "Turn on", "Turn off"], "default": "toggle" }
        }
      }
    },
    {
      "id": "script",
      "name": "Run script",
      "icon": "terminal",
      "description": "Any Voicemeeter script, like Strip[0].Mute=1; Bus[1].Gain=-10;",
      "settings": { "type": "object", "properties": { "script": { "type": "string", "title": "Script", "format": "textarea", "maxLength": 1000 } }, "required": ["script"] }
    },
    {
      "id": "macro",
      "name": "Macro button",
      "icon": "mouse-pointer-click",
      "description": "Presses a button in Voicemeeter's Macro Buttons app. Use Toggle for toggle buttons.",
      "settings": {
        "type": "object",
        "properties": {
          "button": { "type": "integer", "title": "Button number (1 to 80)", "minimum": 1, "maximum": 80, "default": 1 },
          "mode": { "type": "string", "title": "On press", "enum": ["press", "toggle", "on", "off"], "enumNames": ["Press", "Toggle", "Turn on", "Turn off"], "default": "press" }
        },
        "required": ["button"]
      }
    },
    {
      "id": "preset",
      "name": "Load preset",
      "icon": "folder-open",
      "description": "Loads a settings file you saved from Voicemeeter (Menu > Save Settings).",
      "settings": { "type": "object", "properties": { "file": { "type": "string", "title": "Preset file (.xml, full path)", "maxLength": 260 } }, "required": ["file"] }
    },
    {
      "id": "recorder",
      "name": "Recorder",
      "icon": "disc-3",
      "description": "Voicemeeter's built-in recorder and player.",
      "settings": {
        "type": "object",
        "properties": { "op": { "type": "string", "title": "On press", "enum": ["play", "stop", "record", "pause"], "enumNames": ["Play", "Stop", "Record", "Pause"], "default": "play" } }
      }
    }
  ]
}
