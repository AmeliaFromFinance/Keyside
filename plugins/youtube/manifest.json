{
  "id": "dev.keyside.youtube",
  "name": "YouTube Live",
  "version": "1.1.0",
  "author": "Keyside",
  "prefix": "youtube",
  "description": "Live chat, Super Chats, viewer count and stream health from your YouTube stream. Send chat messages and change the title.",
  "homepage": "https://console.cloud.google.com/apis/credentials",
  "license": "GPL-3.0-or-later",
  "host": "^1.0",
  "entry": "main.js",
  "icon": "monitor-play",
  "permissions": { "net": ["oauth2.googleapis.com", "www.googleapis.com"] },
  "setup": [
    "In the [Google Cloud console](https://console.cloud.google.com/projectcreate), create a project.",
    "Enable [YouTube Data API v3](https://console.cloud.google.com/apis/library/youtube.googleapis.com) for it.",
    "Under [Credentials](https://console.cloud.google.com/apis/credentials), create an OAuth client ID of type TVs and Limited Input devices. If asked, set up the consent screen first and add yourself as a test user.",
    "Copy the client ID and secret below and press Save settings.",
    "Keyside shows a code here. Open the link and enter it."
  ],
  "connection": {
    "type": "object",
    "properties": {
      "clientId": {
        "type": "string",
        "title": "Client ID",
        "maxLength": 200
      },
      "clientSecret": { "type": "string", "format": "secret", "title": "Client secret" },
      "session": { "type": "string", "format": "secret", "x-hidden": true }
    }
  },
  "actions": [
    { "id": "send", "name": "Send chat message", "icon": "send", "settings": { "type": "object", "properties": { "message": { "type": "string", "title": "Message", "maxLength": 200 } }, "required": ["message"] } },
    {
      "id": "title",
      "name": "Change title",
      "icon": "pencil",
      "description": "Sets the title of the live broadcast, or the next scheduled one.",
      "settings": { "type": "object", "properties": { "title": { "type": "string", "title": "Title", "maxLength": 100 } }, "required": ["title"] }
    },
    { "id": "health", "name": "Stream health", "icon": "heart-pulse", "description": "What YouTube sees from your encoder. Press to check now." }
  ],
  "variables": [
    { "name": "live", "title": "Live", "type": "boolean" },
    { "name": "viewers", "title": "Viewers", "type": "number" },
    { "name": "likes", "title": "Likes", "type": "number" },
    { "name": "title", "title": "Title", "type": "string" },
    { "name": "health", "title": "Stream health", "type": "string" },
    { "name": "last_superchat", "title": "Latest Super Chat", "type": "string" },
    { "name": "last_member", "title": "Latest member", "type": "string" }
  ],
  "feeds": [
    { "name": "chat", "title": "Chat" },
    { "name": "events", "title": "Super Chats and members" }
  ]
}
