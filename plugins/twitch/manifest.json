{
  "id": "dev.keyside.twitch",
  "name": "Twitch",
  "version": "1.3.0",
  "author": "Keyside",
  "prefix": "twitch",
  "description": "Chat and alerts on your deck, plus markers, clips, ads, chat modes, title, shoutouts and raids.",
  "homepage": "https://dev.twitch.tv/console/apps",
  "license": "GPL-3.0-or-later",
  "host": "^1.1",
  "entry": "main.js",
  "icon": "tv",
  "permissions": { "net": ["id.twitch.tv", "api.twitch.tv", "eventsub.wss.twitch.tv"] },
  "setup": [
    "Open the [Twitch developer console](https://dev.twitch.tv/console/apps/create) and register an application.",
    "Add the OAuth redirect URL `https://localhost`, pick any category and set Client Type to Public.",
    "Press Create, then Manage. Copy the Client ID below and press Save settings.",
    "Keyside shows a code here. Open [twitch.tv/activate](https://www.twitch.tv/activate) and enter it."
  ],
  "connection": {
    "type": "object",
    "properties": {
      "clientId": {
        "type": "string",
        "title": "Client ID",
        "maxLength": 64
      },
      "chat": { "type": "boolean", "title": "Show chat and alerts", "default": true },
      "session": { "type": "string", "format": "secret", "x-hidden": true }
    }
  },
  "actions": [
    { "id": "marker", "name": "Stream marker", "icon": "bookmark", "settings": { "type": "object", "properties": { "description": { "type": "string", "title": "Note", "maxLength": 140 } } } },
    { "id": "clip", "name": "Create clip", "icon": "scissors" },
    {
      "id": "ad",
      "name": "Run ad",
      "icon": "megaphone",
      "settings": { "type": "object", "properties": { "length": { "type": "integer", "title": "Length (seconds)", "minimum": 30, "maximum": 180, "default": 60 } } }
    },
    { "id": "snooze-ad", "name": "Snooze next ad", "icon": "alarm-clock" },
    {
      "id": "chat-mode",
      "name": "Chat mode",
      "icon": "message-square",
      "kind": "toggle",
      "settings": {
        "type": "object",
        "properties": {
          "mode": { "type": "string", "title": "Mode", "enum": ["emote", "slow", "followers", "subs", "unique"], "enumNames": ["Emote only", "Slow mode", "Followers only", "Subscribers only", "Unique chat"], "default": "emote" },
          "op": { "type": "string", "title": "On press", "enum": ["toggle", "on", "off"], "enumNames": ["Toggle", "Turn on", "Turn off"], "default": "toggle" },
          "seconds": { "type": "integer", "title": "Slow mode wait (seconds)", "minimum": 3, "maximum": 120, "default": 30 },
          "minutes": { "type": "integer", "title": "Follow time needed (minutes)", "minimum": 0, "maximum": 129600, "default": 0 }
        }
      }
    },
    { "id": "send", "name": "Send chat message", "icon": "send", "settings": { "type": "object", "properties": { "message": { "type": "string", "title": "Message", "maxLength": 500 } }, "required": ["message"] } },
    {
      "id": "announce",
      "name": "Announcement",
      "icon": "megaphone",
      "settings": {
        "type": "object",
        "properties": {
          "message": { "type": "string", "title": "Message", "maxLength": 500 },
          "color": { "type": "string", "title": "Colour", "enum": ["primary", "blue", "green", "orange", "purple"], "default": "primary" }
        },
        "required": ["message"]
      }
    },
    {
      "id": "title",
      "name": "Stream title",
      "icon": "pencil",
      "settings": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "title": "Title", "maxLength": 140 },
          "category": { "type": "string", "title": "Category", "description": "Exact name, like Just Chatting.", "maxLength": 100 }
        }
      }
    },
    { "id": "shoutout", "name": "Shoutout", "icon": "megaphone", "settings": { "type": "object", "properties": { "user": { "type": "string", "title": "Channel", "maxLength": 25 } }, "required": ["user"] } },
    {
      "id": "raid",
      "name": "Raid",
      "icon": "swords",
      "settings": {
        "type": "object",
        "properties": {
          "user": { "type": "string", "title": "Channel", "maxLength": 25 },
          "op": { "type": "string", "title": "On press", "enum": ["start", "cancel"], "enumNames": ["Start raid", "Cancel raid"], "default": "start" }
        }
      }
    },
    { "id": "clear-chat", "name": "Clear chat", "icon": "trash-2" },
    {
      "id": "shield",
      "name": "Shield mode",
      "icon": "shield",
      "kind": "toggle",
      "settings": {
        "type": "object",
        "properties": { "op": { "type": "string", "title": "On press", "enum": ["toggle", "on", "off"], "enumNames": ["Toggle", "Turn on", "Turn off"], "default": "toggle" } }
      }
    },
    {
      "id": "poll",
      "name": "Poll",
      "icon": "chart-bar",
      "description": "Starts or ends a poll. Shows the leading answer while it runs.",
      "settings": {
        "type": "object",
        "properties": {
          "op": { "type": "string", "title": "On press", "enum": ["start", "end"], "enumNames": ["Start the poll", "End the running poll"], "default": "start" },
          "question": { "type": "string", "title": "Question", "maxLength": 60 },
          "choices": { "type": "string", "title": "Answers, one per line (2 to 5)", "format": "textarea", "maxLength": 200 },
          "seconds": { "type": "integer", "title": "Seconds", "minimum": 15, "maximum": 1800, "default": 120 }
        }
      }
    },
    {
      "id": "prediction",
      "name": "Prediction",
      "icon": "trophy",
      "description": "Starts, locks, resolves or cancels a prediction.",
      "settings": {
        "type": "object",
        "properties": {
          "op": { "type": "string", "title": "On press", "enum": ["start", "lock", "resolve", "cancel"], "enumNames": ["Start", "Lock", "Pick the winner", "Cancel and refund"], "default": "start" },
          "question": { "type": "string", "title": "Question", "maxLength": 45 },
          "outcomes": { "type": "string", "title": "Outcomes, one per line (2 to 10)", "format": "textarea", "maxLength": 300 },
          "seconds": { "type": "integer", "title": "Seconds to predict", "minimum": 30, "maximum": 1800, "default": 120 },
          "winner": { "type": "string", "title": "Winner (name or number)", "maxLength": 25 }
        }
      }
    },
    {
      "id": "reward",
      "name": "Channel point reward",
      "icon": "coins",
      "kind": "toggle",
      "description": "Turns a reward on or off. Twitch only lets apps change rewards they made, so Keyside makes it the first time.",
      "settings": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "title": "Reward name", "maxLength": 45 },
          "cost": { "type": "integer", "title": "Cost in points", "minimum": 1, "maximum": 1000000, "default": 500 },
          "prompt": { "type": "string", "title": "Description", "maxLength": 200 },
          "mode": { "type": "string", "title": "Off means", "enum": ["enable", "pause"], "enumNames": ["Hidden", "Shown but paused"], "default": "enable" },
          "op": { "type": "string", "title": "On press", "enum": ["toggle", "on", "off"], "enumNames": ["Toggle", "Turn on", "Turn off"], "default": "toggle" }
        },
        "required": ["title"]
      }
    }
  ],
  "variables": [
    { "name": "live", "title": "Live", "type": "boolean" },
    { "name": "viewers", "title": "Viewers", "type": "number" },
    { "name": "followers", "title": "Followers", "type": "number" },
    { "name": "subs", "title": "Subscribers", "type": "number" },
    { "name": "title", "title": "Title", "type": "string" },
    { "name": "category", "title": "Category", "type": "string" },
    { "name": "last_follower", "title": "Latest follower", "type": "string" },
    { "name": "last_sub", "title": "Latest subscriber", "type": "string" },
    { "name": "last_cheer", "title": "Latest cheer", "type": "string" },
    { "name": "last_raid", "title": "Latest raid", "type": "string" },
    { "name": "last_redeem", "title": "Latest channel point redemption", "type": "string" }
  ],
  "feeds": [
    { "name": "chat", "title": "Chat" },
    { "name": "events", "title": "Alerts" }
  ]
}
