{
  "id": "dev.phonedeck.streamlabs",
  "name": "Streamlabs Desktop",
  "version": "1.0.0",
  "author": "PhoneDeck",
  "prefix": "slobs",
  "description": "Scenes, audio, recording, streaming and replays in Streamlabs Desktop, with live state on the keys.",
  "homepage": "https://streamlabs.com",
  "license": "GPL-3.0-only",
  "host": "^1.0",
  "entry": "main.js",
  "icon": "radio",
  "permissions": { "net": ["{host}:{port}"] },
  "connection": {
    "type": "object",
    "properties": {
      "host": { "type": "string", "title": "Address", "default": "127.0.0.1" },
      "port": { "type": "integer", "title": "Port", "default": 59650, "minimum": 1, "maximum": 65535 },
      "token": { "type": "string", "format": "secret", "title": "API token", "description": "Streamlabs Desktop: Settings > Remote Control > click the QR code > Show details." }
    },
    "required": ["host", "port"]
  },
  "actions": [
    {
      "id": "scene",
      "name": "Switch scene",
      "icon": "monitor",
      "settings": { "type": "object", "properties": { "scene": { "type": "string", "title": "Scene", "x-options": "dynamic" } }, "required": ["scene"] }
    },
    {
      "id": "mute",
      "name": "Mute audio",
      "icon": "mic",
      "kind": "toggle",
      "settings": {
        "type": "object",
        "properties": {
          "source": { "type": "string", "title": "Audio source", "x-options": "dynamic" },
          "mode": { "type": "string", "title": "On press", "enum": ["toggle", "on", "off"], "enumNames": ["Toggle", "Mute", "Unmute"], "default": "toggle" }
        },
        "required": ["source"]
      }
    },
    {
      "id": "volume",
      "name": "Volume",
      "icon": "volume-2",
      "kind": "slider",
      "settings": { "type": "object", "properties": { "source": { "type": "string", "title": "Audio source", "x-options": "dynamic" } }, "required": ["source"] }
    },
    { "id": "record", "name": "Start or stop recording", "icon": "circle-dot", "kind": "toggle" },
    { "id": "stream", "name": "Go live or end stream", "icon": "radio-tower", "kind": "toggle" },
    {
      "id": "replay",
      "name": "Replay buffer",
      "icon": "history",
      "settings": {
        "type": "object",
        "properties": { "mode": { "type": "string", "title": "On press", "enum": ["save", "toggle"], "enumNames": ["Save replay", "Start or stop the buffer"], "default": "save" } }
      }
    }
  ],
  "variables": [
    { "name": "scene", "title": "Live scene", "type": "string" },
    { "name": "recording", "title": "Recording", "type": "boolean" },
    { "name": "streaming", "title": "Streaming", "type": "boolean" }
  ]
}
