{
  "id": "dev.keyside.vtubestudio",
  "name": "VTube Studio",
  "version": "1.1.0",
  "author": "Keyside",
  "prefix": "vts",
  "description": "Hotkeys, expressions and model switching, with the active model and expressions lit up.",
  "homepage": "https://denchisoft.com",
  "license": "GPL-3.0-or-later",
  "host": "^1.0",
  "entry": "main.js",
  "icon": "scan-face",
  "permissions": { "net": ["{host}:{port}"] },
  "setup": [
    "In VTube Studio, open Settings and turn on Start API (port `8001`).",
    "Press Save settings. VTube Studio asks to allow Keyside. Press Allow."
  ],
  "connection": {
    "type": "object",
    "properties": {
      "host": { "type": "string", "title": "Address", "default": "127.0.0.1" },
      "port": { "type": "integer", "title": "Port", "default": 8001, "minimum": 1, "maximum": 65535 },
      "token": { "type": "string", "format": "secret", "x-hidden": true }
    },
    "required": ["host", "port"]
  },
  "actions": [
    {
      "id": "hotkey",
      "name": "Hotkey",
      "icon": "zap",
      "settings": { "type": "object", "properties": { "hotkey": { "type": "string", "title": "Hotkey", "x-options": "dynamic" } }, "required": ["hotkey"] }
    },
    {
      "id": "expression",
      "name": "Expression",
      "icon": "smile",
      "kind": "toggle",
      "settings": {
        "type": "object",
        "properties": {
          "expression": { "type": "string", "title": "Expression", "x-options": "dynamic" },
          "mode": { "type": "string", "title": "On press", "enum": ["toggle", "on", "off", "hold"], "enumNames": ["Toggle", "Turn on", "Turn off", "On while held"], "default": "toggle" }
        },
        "required": ["expression"]
      }
    },
    {
      "id": "model",
      "name": "Load model",
      "icon": "user-round",
      "settings": { "type": "object", "properties": { "model": { "type": "string", "title": "Model", "x-options": "dynamic" } }, "required": ["model"] }
    },
    {
      "id": "item",
      "name": "Item",
      "icon": "sparkles",
      "kind": "toggle",
      "description": "Shows or hides a prop, sticker or animation.",
      "settings": {
        "type": "object",
        "properties": {
          "item": { "type": "string", "title": "Item", "x-options": "dynamic" },
          "mode": { "type": "string", "title": "On press", "enum": ["toggle", "on", "off"], "enumNames": ["Toggle", "Show", "Hide"], "default": "toggle" },
          "x": { "type": "number", "title": "Position left to right (-1 to 1)", "minimum": -1, "maximum": 1, "default": 0 },
          "y": { "type": "number", "title": "Position bottom to top (-1 to 1)", "minimum": -1, "maximum": 1, "default": 0 },
          "size": { "type": "number", "title": "Size (0 to 1)", "minimum": 0, "maximum": 1, "default": 0.32 }
        },
        "required": ["item"]
      }
    },
    {
      "id": "parameter",
      "name": "Move a parameter",
      "icon": "move",
      "kind": "slider",
      "description": "Takes over a tracking parameter, like head tilt. Slide back to its default to hand it back to tracking.",
      "settings": { "type": "object", "properties": { "parameter": { "type": "string", "title": "Parameter", "x-options": "dynamic" } }, "required": ["parameter"] }
    }
  ],
  "variables": [{ "name": "model", "title": "Current model", "type": "string" }]
}
